# Copy to .env.local and fill in. Never commit real keys.
# Without the two Supabase vars the app runs in local demo mode (IndexedDB only).

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server only — used by /api/account (delete) and the payment webhook. Bypasses RLS.
SUPABASE_SECRET_KEY=sb_secret_xxx

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_VERSION=0.1.0

# --- Pricing (IDR, still open — BRIEF §12) ---
NEXT_PUBLIC_PRICE_MONTHLY_IDR=39000
NEXT_PUBLIC_PRICE_YEARLY_IDR=299000
NEXT_PUBLIC_TRIAL_DAYS=0

# --- Payments: Midtrans Snap (sandbox by default) ---
MIDTRANS_ENV=sandbox
MIDTRANS_SERVER_KEY=
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
